+//! A batch plan holds original item positions and the shared output budget.
+use super::budget;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Slot(usize);
+
+impl Slot {
+    pub fn index(self) -> usize {
+        self.0
+    }
+
+    pub fn number(self) -> usize {
+        self.0 + 1
+    }
+}
+
+pub struct BatchPlan {
+    pub slots: Vec<Slot>,
+    pub bytes: usize,
+}
+
+impl BatchPlan {
+    /// Resolve the requested slots before doing any per-item work.
+    pub fn new(count: usize, pick: Option<&str>, max_chars: Option<usize>, floor: usize) -> Result<Self, String> {
+        if pick.is_some() {
+            return Err("Error: pick is not implemented".into());
+        }
+        Ok(Self {
+            slots: (0..count).map(Slot).collect(),
+            bytes: budget::limit(max_chars, floor),
+        })
+    }
+}
