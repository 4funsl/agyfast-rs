@@ -0,0 +1,50 @@
+//! Public examples from clients. Each test runs the actual one-shot entry point.
+use serde_json::{Value, json};
+use std::path::Path;
+use std::process::Command;
+
+fn request(root: &Path, verb: &str, args: Value) -> (bool, String) {
+    let out = Command::new(env!("CARGO_BIN_EXE_agy-rs"))
+        .current_dir(root)
+        .args(["cli", verb, "--json", &args.to_string()])
+        .output().unwrap();
+    (out.status.success(), String::from_utf8(out.stdout).unwrap())
+}
+
+#[test]
+fn replay_a_saved_query_list() {
+    let dir = tempfile::tempdir().unwrap();
+    let (ok, text) = request(dir.path(), "search", json!({
+        "queries": [{"type":"text","pattern":"one"}, {"type":"text","pattern":"two"}, {"type":"text","pattern":"three"}],
+        "pick":"3,1-2,!1"
+    }));
+    assert!(ok, "{text}");
+    let heads: Vec<_> = text.lines().filter(|l| l.starts_with("##")).collect();
+    assert_eq!(heads, ["## Query 3 [text] three", "## Query 2 [text] two"]);
+}
+
+#[test]
+fn report_still_shows_a_short_hit_when_a_context_block_will_not_fit() {
+    let dir = tempfile::tempdir().unwrap();
+    let padding = "λ".repeat(110);
+    std::fs::write(dir.path().join("a.txt"), format!("{padding}\n{padding}\nneedle\n{padding}\n{padding}\n")).unwrap();
+    std::fs::write(dir.path().join("b.txt"), "needle\n").unwrap();
+    let (ok, text) = request(dir.path(), "search", json!({
+        "queries": [{"type":"text","pattern":"needle","contextLines":2}],
+        "maxChars":500
+    }));
+    assert!(ok, "{text}");
+    assert!(text.contains("b.txt\n 1: needle") && text.contains("showing 1 of 2"), "{text}");
+    assert!(text.trim_end_matches('\n').len() <= 500);
+}
+
+#[test]
+fn failure_report_supplies_a_reusable_selector() {
+    let dir = tempfile::tempdir().unwrap();
+    let (ok, text) = request(dir.path(), "check", json!({
+        "commands": [{"command":"false"}, {"command":"false"}, {"command":"true"}, {"command":"false"}],
+        "pick":"4,1-3"
+    }));
+    assert!(ok && text.starts_with("Checks: 1/4 passed, 3 failed"), "{text}");
+    assert_eq!(text.lines().last(), Some("Replay failed: 1-2,4"));
+}
