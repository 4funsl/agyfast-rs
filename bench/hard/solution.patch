+fn replay_ranges(mut numbers: Vec<usize>) -> String {
+    if numbers.is_empty() {
+        return "-".into();
+    }
+    numbers.sort_unstable();
+    let mut ranges = Vec::new();
+    let mut it = numbers.into_iter().peekable();
+    while let Some(first) = it.next() {
+        let mut last = first;
+        while it.next_if_eq(&(last + 1)).is_some() {
+            last += 1;
+        }
+        ranges.push(if first == last { first.to_string() } else { format!("{first}-{last}") });
+    }
+    ranges.join(",")
 }
 
