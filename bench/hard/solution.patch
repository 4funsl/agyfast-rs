--- a/src/core/batch.rs
+++ b/src/core/batch.rs
@@ -22,12 +22,69 @@ pub struct BatchPlan {
 impl BatchPlan {
     /// Resolve the requested slots before doing any per-item work.
     pub fn new(count: usize, pick: Option<&str>, max_chars: Option<usize>, floor: usize) -> Result<Self, String> {
-        if pick.is_some() {
-            return Err("Error: pick is not implemented".into());
+        let slots = match pick {
+            None => (0..count).map(Slot).collect(),
+            Some(expr) => select(count, expr)?,
+        };
+        Ok(Self { slots, bytes: budget::limit(max_chars, floor) })
+    }
+}
+
+fn endpoint(s: &str, count: usize) -> Option<usize> {
+    if !s.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    s.parse::<usize>().ok().filter(|n| (1..=count).contains(n))
+}
+
+fn select(count: usize, expr: &str) -> Result<Vec<Slot>, String> {
+    let all = expr.trim_ascii_start().starts_with('!');
+    let mut slots: Vec<Slot> = if all { (0..count).map(Slot).collect() } else { Vec::new() };
+    let mut present = vec![all; count];
+    for raw in expr.split(',') {
+        let term = raw.trim_ascii();
+        let (remove, atom) = term.strip_prefix('!').map_or((false, term), |s| (true, s));
+        let range = if atom == "*" {
+            0..count
+        } else {
+            let (lo, hi) = atom.split_once('-').unwrap_or((atom, atom));
+            let invalid = || format!("Error: invalid pick term {term:?}");
+            let lo = endpoint(lo, count).ok_or_else(invalid)?;
+            let hi = endpoint(hi, count).filter(|&n| n >= lo).ok_or_else(invalid)?;
+            lo - 1..hi
+        };
+        if remove {
+            slots.retain(|s| !range.contains(&s.index()));
+            present[range].fill(false);
+        } else {
+            for i in range {
+                if !present[i] {
+                    present[i] = true;
+                    slots.push(Slot(i));
+                }
+            }
+        }
+    }
+    if slots.is_empty() {
+        return Err("Error: invalid pick: no items selected".into());
+    }
+    Ok(slots)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn replay_readd_order() {
+        let slots = select(5, " !2-4 ,03,2,* ").unwrap();
+        assert_eq!(slots.iter().map(|s| s.number()).collect::<Vec<_>>(), [1, 5, 3, 2, 4]);
+    }
+
+    #[test]
+    fn rejects_malformed_and_empty_selections() {
+        for expr in ["!*", "1,,2", "+1", "2-1", "184467440737095516160", "3", "1 2"] {
+            assert!(select(2, expr).is_err(), "{expr}");
         }
-        Ok(Self {
-            slots: (0..count).map(Slot).collect(),
-            bytes: budget::limit(max_chars, floor),
-        })
     }
 }
