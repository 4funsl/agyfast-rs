+
+impl Range {
+    // Convert the unified range to zero-based boundary coordinates.
+    pub(super) fn boundaries(self) -> (u64, u64) {
+        let begin = if self.count == 0 {
+            self.start
+        } else {
+            self.start - 1
+        };
+        (begin, begin + self.count)
+    }
+}
