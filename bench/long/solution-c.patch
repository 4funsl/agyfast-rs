+fn tagged(line: &str) -> Option<(&str, &str)> {
+    let (lane, body) = line.strip_prefix('[')?.split_once("] ")?;
+    (!lane.is_empty()).then_some((lane, body))
+}
+
+pub(super) fn parse(src: &str) -> Result<Report, String> {
+    let lines: Vec<_> = src.lines().collect();
+    if !lines.first().is_some_and(|s| tagged(s).is_some()) {
+        return session(lines);
+    }
+    let mut lanes = Vec::new();
+    let mut streams = std::collections::BTreeMap::new();
+    for (i, line) in lines.iter().enumerate() {
+        let (lane, body) = tagged(line).ok_or_else(|| error(i + 1, "missing lane"))?;
+        let stream = streams.entry(lane).or_insert_with(|| {
+            lanes.push(lane);
+            Vec::new()
+        });
+        stream.push((i + 1, body));
+    }
+    let mut result = Report {
+        rows: Vec::new(),
+        summary: json!({"pass":0,"fail":0,"skip":0,"todo":0}),
+    };
+    for lane in lanes {
+        let records = &streams[lane];
+        let report = session(records.iter().map(|(_, s)| *s).collect()).map_err(|message| {
+            // Session diagnostics use one-based positions within this lane.
+            let Some((pos, why)) = message
+                .strip_prefix("tap line ")
+                .and_then(|s| s.split_once(": "))
+            else {
+                return message;
+            };
+            let index = pos.parse::<usize>().expect("session line number");
+            error(records.get(index - 1).map_or(lines.len() + 1, |r| r.0), why)
+        })?;
+        for mut row in report.rows {
+            row["lane"] = json!(lane);
+            result.rows.push(row);
+        }
+        for key in ["pass", "fail", "skip", "todo"] {
+            result.summary[key] = json!(
+                result.summary[key].as_u64().unwrap() + report.summary[key].as_u64().unwrap()
+            );
+        }
+    }
+    Ok(result)
+}
