+++ b/src/tools/report/diff/regions.rs
@@ -0,0 +1,76 @@
+use super::*;
+#[derive(Default)]
+struct Edit {
+    old_at: u64,
+    new_at: u64,
+    removed: u64,
+    added: u64,
+}
+
+impl Edit {
+    fn flush(&mut self, hunk: &Hunk<'_>, rows: &mut Vec<Value>) {
+        if self.removed == 0 && self.added == 0 {
+            return;
+        }
+        rows.push(json!({
+            "old":hunk.old, "new":hunk.new, "hunk":hunk.id, "heading":hunk.heading,
+            "oldAt":self.old_at, "newAt":self.new_at, "removed":self.removed, "added":self.added,
+        }));
+        *self = Self::default();
+    }
+}
+
+const MARKER: &str = "\\ No newline at end of file";
+
+pub(super) fn body(
+    lines: &[&str],
+    pos: &mut usize,
+    old: Range,
+    new: Range,
+    h: Hunk<'_>,
+    rows: &mut Vec<Value>,
+    totals: &mut Totals,
+) -> Result<(), String> {
+    let (mut left, mut right) = (0, 0);
+    let mut edit = Edit::default();
+    let mut marker_allowed = false;
+    loop {
+        let line = lines.get(*pos).copied();
+        if line == Some(MARKER) && marker_allowed {
+            *pos += 1;
+            marker_allowed = false;
+            continue;
+        }
+        if (left, right) == (old.count, new.count) {
+            break;
+        }
+        let n = *pos + 1;
+        let op = line.and_then(|s| s.as_bytes().first()).copied();
+        if edit.added == 0 && edit.removed == 0 {
+            edit.old_at = old.start + left;
+            edit.new_at = new.start + right;
+        }
+        match op {
+            Some(b' ') if left < old.count && right < new.count => {
+                edit.flush(&h, rows);
+                left += 1;
+                right += 1;
+            }
+            Some(b'-') if left < old.count => {
+                edit.removed += 1;
+                totals.removed += 1;
+                left += 1;
+            }
+            Some(b'+') if right < new.count => {
+                edit.added += 1;
+                totals.added += 1;
+                right += 1;
+            }
+            _ => return Err(error(n, "hunk body does not match ranges")),
+        }
+        *pos += 1;
+        marker_allowed = true;
+    }
+    edit.flush(&h, rows);
+    Ok(())
+}
diff --git a/src/tools/report/lcov/mod.rs b/src/tools/report/lcov/mod.rs
new file mode 100644
index 0000000..ab6c5c2
--- /dev/null
+++ b/src/tools/report/lcov/mod.rs
@@ -0,0 +1,106 @@
+mod paths;
+mod source;
+use super::Report;
+use paths::filename;
+use serde_json::{Value, json};
+use source::Source;
+use std::collections::BTreeMap;
+
+type Parsed<T> = Result<T, &'static str>;
+
+fn integer(raw: &str) -> Parsed<u64> {
+    if raw.is_empty() || !raw.bytes().all(|c| c.is_ascii_digit()) {
+        return Err("expected unsigned decimal");
+    }
+    raw.parse().map_err(|_| "integer overflow")
+}
+
+fn coordinate(raw: &str) -> Parsed<u64> {
+    match integer(raw)? {
+        0 => Err("line zero"),
+        n => Ok(n),
+    }
+}
+
+#[derive(Default)]
+struct Reader {
+    files: BTreeMap<String, Source>,
+    current: Option<String>,
+    records: usize,
+}
+
+impl Reader {
+    fn line(&mut self, line: &str) -> Parsed<()> {
+        if line.is_empty() || line.starts_with("TN:") {
+            return Ok(());
+        }
+        if line == "end_of_record" {
+            self.current.take().ok_or("unmatched end_of_record")?;
+            self.records += 1;
+            return Ok(());
+        }
+        let (tag, raw) = line.split_once(':').ok_or("missing field separator")?;
+        if tag == "SF" {
+            if self.current.is_some() {
+                return Err("nested source record");
+            }
+            let path = filename(raw)?;
+            self.files.entry(path.clone()).or_default();
+            self.current = Some(path);
+            return Ok(());
+        }
+        let path = self.current.as_ref().ok_or("field outside source record")?;
+        let source = self.files.get_mut(path).expect("registered on SF");
+        match tag {
+            "DA" => source.add_line(raw),
+            "FN" | "FNDA" => source.function(raw, tag == "FN"),
+            "BRDA" => source.branch(raw),
+            "LF" | "LH" | "FNF" | "FNH" | "BRF" | "BRH" => Ok(()),
+            _ => Err("unsupported field"),
+        }
+    }
+}
+
+pub(super) fn parse(src: &str) -> Result<Report, String> {
+    let mut reader = Reader::default();
+    let mut last = 0;
+    for (index, line) in src.lines().enumerate() {
+        last = index + 1;
+        reader
+            .line(line)
+            .map_err(|e| format!("lcov line {last}: {e}"))?;
+    }
+    if reader.current.is_some() {
+        return Err(format!("lcov line {}: missing end_of_record", last + 1));
+    }
+    let rows: Vec<_> = reader
+        .files
+        .iter()
+        .map(|(path, file)| file.row(path))
+        .collect();
+    let lines: usize = reader.files.values().map(Source::lines).sum();
+    let covered: usize = reader.files.values().map(Source::covered).sum();
+    Ok(Report {
+        summary: json!({"files":rows.len(),"records":reader.records,"lines":lines,"covered":covered}),
+        rows,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn lcov_merge_checksums() {
+        let data = "SF:x\nDA:2,0,one\nend_of_record\nSF:./x\nDA:2,1,two\nend_of_record";
+        assert!(parse(data).err().unwrap().starts_with("lcov line 5:"));
+    }
+
+    #[test]
+    fn lcov_unknown_branch() {
+        let report = parse("SF:x\nBRDA:3,0,0,-\nBRDA:3,0,0,0\nend_of_record").unwrap();
+        assert_eq!(report.rows[0]["unknown"], 0);
+        assert_eq!(report.rows[0]["taken"], 0);
+        assert_eq!(report.rows[0]["branches"], 1);
+    }
+}
