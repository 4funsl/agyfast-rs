diff --git a/tests/report_support/mod.rs b/tests/report_support/mod.rs
new file mode 100644
index 0000000..d3909e9
--- /dev/null
+++ b/tests/report_support/mod.rs
@@ -0,0 +1,38 @@
+use serde_json::{Value, json};
+use std::path::Path;
+use std::process::Command;
+
+pub fn replay(format: &str, case: &str) {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("fixtures/reports")
+        .join(format);
+    let input = root.join(format!("{case}.{format}"));
+    let expected = std::fs::read_to_string(root.join(format!("{case}.checks.json"))).unwrap();
+    let checks: Value = serde_json::from_str(&expected).unwrap();
+    let args = json!({"format":format,"path":input});
+    let output = Command::new(env!("CARGO_BIN_EXE_agy-rs"))
+        .args(["cli", "inspect", "--json", &args.to_string()])
+        .output()
+        .unwrap();
+    let text = String::from_utf8(output.stdout).unwrap();
+    if let Some(line) = checks.get("errorLine") {
+        assert!(
+            !output.status.success(),
+            "{case} expected rejection: {text}"
+        );
+        assert!(
+            text.contains(&format!("{format} line {line}:")),
+            "{case}: {text}"
+        );
+        return;
+    }
+    assert!(output.status.success(), "{case}: {text}");
+    let report: Value = serde_json::from_str(&text).unwrap();
+    for (pointer, want) in checks.as_object().unwrap() {
+        assert_eq!(
+            report.pointer(pointer),
+            Some(want),
+            "{case} {pointer}: {text}"
+        );
+    }
+}
