+++ b/src/tools/report/lcov/paths.rs
@@ -0,0 +1,26 @@
+use super::Parsed;
+pub(super) fn filename(raw: &str) -> Parsed<String> {
+    // Coverage exporters on Windows may use either separator.
+    let slashes = raw.replace('\\', "/");
+    let raw = slashes.as_str();
+    let absolute = raw.starts_with('/');
+    let mut parts = Vec::new();
+    for component in raw.split('/') {
+        match component {
+            "" | "." => {}
+            ".." if parts.last().is_some_and(|p| *p != "..") => {
+                parts.pop();
+            }
+            ".." if absolute => {}
+            _ => parts.push(component),
+        }
+    }
+    if parts.is_empty() {
+        return Err("empty source path");
+    }
+    Ok(format!(
+        "{}{}",
+        if absolute { "/" } else { "" },
+        parts.join("/")
+    ))
+}
diff --git a/src/tools/report/lcov/source.rs b/src/tools/report/lcov/source.rs
new file mode 100644
index 0000000..277e5b0
--- /dev/null
+++ b/src/tools/report/lcov/source.rs
@@ -0,0 +1,116 @@
+use super::*;
+#[derive(Default)]
+struct Line {
+    hits: u64,
+    checksum: Option<String>,
+}
+
+#[derive(Default)]
+struct Function {
+    declaration: Option<u64>,
+    hits: u64,
+}
+
+#[derive(Default)]
+pub(super) struct Source {
+    lines: BTreeMap<u64, Line>,
+    functions: BTreeMap<String, Function>,
+    branches: BTreeMap<(u64, u64, u64), Option<u64>>,
+}
+
+impl Source {
+    pub(super) fn add_line(&mut self, raw: &str) -> Parsed<()> {
+        let mut fields = raw.split(',');
+        let pos = coordinate(fields.next().unwrap_or(""))?;
+        let hits = integer(fields.next().ok_or("missing hit count")?)?;
+        let checksum = fields.next();
+        if fields.next().is_some() || checksum == Some("") {
+            return Err("invalid DA checksum");
+        }
+        let line = self.lines.entry(pos).or_default();
+        if let Some(value) = checksum {
+            if line.checksum.as_deref().is_some_and(|old| old != value) {
+                return Err("conflicting checksum");
+            }
+            line.checksum = Some(value.into());
+        }
+        line.hits = line.hits.saturating_add(hits);
+        Ok(())
+    }
+
+    pub(super) fn function(&mut self, raw: &str, declaration: bool) -> Parsed<()> {
+        let (value, name) = raw.split_once(',').ok_or("missing function name")?;
+        if name.is_empty() {
+            return Err("empty function name");
+        }
+        let function = self.functions.entry(name.to_owned()).or_default();
+        if declaration {
+            let line = coordinate(value)?;
+            if function.declaration.is_some_and(|old| old != line) {
+                return Err("conflicting function declaration");
+            }
+            function.declaration = Some(line);
+        } else {
+            function.hits = function.hits.saturating_add(integer(value)?);
+        }
+        Ok(())
+    }
+
+    pub(super) fn branch(&mut self, raw: &str) -> Parsed<()> {
+        let fields: Vec<_> = raw.split(',').collect();
+        let [line, block, branch, taken] = fields.as_slice() else {
+            return Err("invalid BRDA");
+        };
+        let counts = self
+            .branches
+            .entry((coordinate(line)?, integer(block)?, integer(branch)?))
+            .or_default();
+        if *taken != "-" {
+            *counts = Some(counts.unwrap_or(0).saturating_add(integer(taken)?));
+        }
+        Ok(())
+    }
+
+    fn gaps(&self) -> Vec<[u64; 2]> {
+        let mut gaps: Vec<[u64; 2]> = Vec::new();
+        for (&line, _) in self.lines.iter().filter(|(_, data)| data.hits == 0) {
+            if let Some(last) = gaps.last_mut()
+                && last[1].checked_add(1) == Some(line)
+            {
+                last[1] = line;
+            } else {
+                gaps.push([line, line]);
+            }
+        }
+        gaps
+    }
+
+    pub(super) fn lines(&self) -> usize {
+        self.lines.len()
+    }
+    pub(super) fn covered(&self) -> usize {
+        self.lines.values().filter(|l| l.hits > 0).count()
+    }
+
+    pub(super) fn row(&self, path: &str) -> Value {
+        let uncovered: Vec<_> = self
+            .functions
+            .iter()
+            .filter(|(_, f)| f.hits == 0)
+            .map(|(name, _)| name)
+            .collect();
+        let mut hits = 0u64;
+        for line in self.lines.values() {
+            hits = hits.saturating_add(line.hits);
+        }
+        json!({
+            "path":path, "lines":self.lines.len(),
+            "covered":self.lines.values().filter(|l| l.hits > 0).count(),
+            "hits": hits, "gaps":self.gaps(),
+            "functions":self.functions.len(), "uncoveredFunctions":uncovered,
+            "branches":self.branches.len(),
+            "taken":self.branches.values().filter(|v| v.is_some_and(|n| n > 0)).count(),
+            "unknown":self.branches.values().filter(|v| v.is_none()).count(),
+        })
+    }
+}
