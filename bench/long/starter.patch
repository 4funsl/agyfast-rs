+++ b/src/tools/report/tap/diagnostic.rs
@@ -0,0 +1,26 @@
+use super::*;
+impl<'a> Reader<'a> {
+    pub(super) fn diagnostic(&mut self, depth: usize) -> Result<Vec<&'a str>, String> {
+        let indent = depth * 4 + 2;
+        let mut data = Vec::new();
+        let deindent = |line: &'a str| {
+            line.get(..indent)
+                .filter(|s| s.bytes().all(|b| b == b' '))
+                .map(|_| &line[indent..])
+        };
+        if self.lines.get(self.pos).and_then(|s| deindent(s)) != Some("---") {
+            return Ok(data);
+        }
+        self.pos += 1;
+        while let Some(line) = self.lines.get(self.pos) {
+            let body =
+                deindent(line).ok_or_else(|| error(self.pos + 1, "diagnostic indentation"))?;
+            self.pos += 1;
+            if body == "..." {
+                return Ok(data);
+            }
+            data.push(body);
+        }
+        Err(error(self.pos + 1, "unterminated diagnostic"))
+    }
+}
