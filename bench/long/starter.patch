+++ b/src/tools/report/mod.rs
@@ -0,0 +1,51 @@
+//! Read-only report inspection. Format adapters own parsing and ordering.
+//! The transport keeps a prefix of complete rows and preserves full totals.
+mod diff;
+mod lcov;
+mod tap;
+
+use crate::core::{budget, cwd};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+pub(super) struct Report {
+    pub summary: Value,
+    pub rows: Vec<Value>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Request {
+    cwd: Option<String>,
+    path: String,
+    format: String,
+    max_chars: Option<usize>,
+}
+
+pub fn run(args: Value) -> Result<String, String> {
+    let req: Request = serde_json::from_value(args).map_err(|e| e.to_string())?;
+    let dir = cwd::resolve(req.cwd.as_deref())?;
+    let src = crate::tools::outline::read_text(&dir.join(req.path))?;
+    let report = match req.format.as_str() {
+        "diff" => diff::parse(&src),
+        "lcov" => lcov::parse(&src),
+        "tap" => tap::parse(&src),
+        _ => return Err("unknown report format".into()),
+    }?;
+    let cap = budget::limit(req.max_chars, 512);
+    let render = |n: usize| json!({
+        "summary": report.summary,
+        "rows": &report.rows[..n],
+        "omitted": report.rows.len() - n,
+    }).to_string();
+    // Serialized prefix size is monotone: a row adds at least one byte
+    // even when the decimal omission count loses a digit.
+    let (mut lo, mut hi) = (0, report.rows.len());
+    while lo < hi {
+        let mid = lo + (hi - lo).div_ceil(2);
+        if render(mid).len() <= cap { lo = mid } else { hi = mid - 1 }
+    }
+    let text = render(lo);
+    if text.len() > cap { return Err("summary exceeds report budget".into()); }
+    Ok(text)
+}
