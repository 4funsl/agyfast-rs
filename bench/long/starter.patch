--- /dev/null
+++ b/src/tools/report/diff/paths.rs
@@ -0,0 +1,46 @@
+use super::error;
+/// A quoted Git path encodes bytes, so octal escapes must be decoded
+/// before checking UTF-8 (a scalar can span several escapes).
+fn quoted_path(raw: &str) -> Option<String> {
+    let body = raw.strip_prefix('"')?.strip_suffix('"')?;
+    let mut bytes = body.bytes();
+    let mut out = Vec::new();
+    while let Some(b) = bytes.next() {
+        match b {
+            b'"' => return None,
+            b'\\' => match bytes.next()? {
+                b @ (b'\\' | b'"') => out.push(b),
+                b't' => out.push(b'\t'),
+                b'n' => out.push(b'\n'),
+                a @ b'0'..=b'3' => {
+                    let b = bytes.next()?.checked_sub(b'0')?;
+                    let c = bytes.next()?.checked_sub(b'0')?;
+                    if b > 7 || c > 7 {
+                        return None;
+                    }
+                    out.push((a - b'0') * 64 + b * 8 + c);
+                }
+                _ => return None,
+            },
+            _ => out.push(b),
+        }
+    }
+    String::from_utf8(out).ok()
+}
+
+pub(super) fn path(raw: &str, prefix: &str, line: usize) -> Result<Option<String>, String> {
+    let field = raw.split('\t').next().unwrap_or("");
+    let value = if field.starts_with('"') {
+        quoted_path(field).ok_or_else(|| error(line, "bad quoted path"))?
+    } else {
+        field.to_owned()
+    };
+    if value == "/dev/null" {
+        return Ok(None);
+    }
+    let name = value.strip_prefix(prefix).unwrap_or(&value);
+    if name.is_empty() {
+        return Err(error(line, "empty path"));
+    }
+    Ok(Some(name.to_owned()))
+}
