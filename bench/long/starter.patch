index 0000000..afedc21
--- /dev/null
+++ b/src/tools/report/tap/mod.rs
@@ -0,0 +1,146 @@
+mod diagnostic;
+mod point;
+use super::Report;
+use point::{Point, count, directive, point};
+use serde_json::{Value, json};
+
+fn error(line: usize, text: &str) -> String {
+    format!("tap line {line}: {text}")
+}
+
+#[derive(Default)]
+struct Reader<'a> {
+    lines: Vec<&'a str>,
+    pos: usize,
+    rows: Vec<Value>,
+    passed: usize,
+    failed: usize,
+    skipped: usize,
+    todo: usize,
+}
+
+impl<'a> Reader<'a> {
+    fn record(
+        &mut self,
+        point: Point<'a>,
+        scope: &[&str],
+        number: usize,
+        diag: Vec<&str>,
+        child: bool,
+    ) {
+        match point.status {
+            "pass" => self.passed += 1,
+            "fail" => self.failed += 1,
+            "skip" => self.skipped += 1,
+            _ => self.todo += 1,
+        }
+        self.rows.push(json!({
+            "scope":scope, "number":number, "name":point.name, "status":point.status,
+            "reason":point.reason, "diagnostic":diag, "subtest":child,
+        }));
+    }
+
+    fn suite(&mut self, scope: &mut Vec<&'a str>) -> Result<(), String> {
+        let depth = scope.len();
+        let mut seen = 0;
+        let mut plan = None;
+        let mut child = None;
+        let mut trailing_plan = false;
+        while let Some(raw) = self.lines.get(self.pos).copied() {
+            if raw.trim().is_empty() {
+                self.pos += 1;
+                continue;
+            }
+            let indent = raw.len() - raw.trim_start_matches(' ').len();
+            if indent < depth * 4 {
+                break;
+            }
+            let n = self.pos + 1;
+            if indent != depth * 4 {
+                return Err(error(n, "unexpected indentation"));
+            }
+            self.pos += 1;
+            let line = &raw[indent..];
+            if line == "TAP version 13" && depth == 0 && n == 1 {
+                continue;
+            }
+            if line.starts_with("Bail out!") {
+                return Err(error(n, "bailout"));
+            }
+            if let Some(name) = line.strip_prefix("# Subtest: ") {
+                if name.is_empty() || child.is_some() || trailing_plan || depth >= 64 {
+                    return Err(error(n, "invalid subtest"));
+                }
+                scope.push(name);
+                self.suite(scope)?;
+                scope.pop();
+                child = Some(name);
+                continue;
+            }
+            if line.starts_with('#') {
+                continue;
+            }
+            if let Some(tail) = line.strip_prefix("1..") {
+                let (end, dir) = directive(tail);
+                let size = count(end).ok_or_else(|| error(n, "invalid plan"))?;
+                if plan.is_some()
+                    || child.is_some()
+                    || dir.is_some_and(|(k, _)| k != "skip" || size != 0)
+                {
+                    return Err(error(n, "unexpected plan"));
+                }
+                plan = Some(size);
+                trailing_plan = seen > 0;
+                continue;
+            }
+            if trailing_plan {
+                return Err(error(n, "point after trailing plan"));
+            }
+            let item =
+                point(line, seen + 1).ok_or_else(|| error(n, "invalid test point or numbering"))?;
+            if child.is_some_and(|name| name != item.name) {
+                return Err(error(n, "subtest result name mismatch"));
+            }
+            seen += 1;
+            let diag = self.diagnostic(depth)?;
+            self.record(item, scope, seen, diag, child.take().is_some());
+        }
+        if child.is_some() || plan != Some(seen) {
+            return Err(error(self.pos + 1, "missing result or plan mismatch"));
+        }
+        Ok(())
+    }
+}
+
+pub(super) fn parse(src: &str) -> Result<Report, String> {
+    let mut reader = Reader {
+        lines: src.lines().collect(),
+        ..Reader::default()
+    };
+    reader.suite(&mut Vec::new())?;
+    Ok(Report {
+        summary: json!({"pass":reader.passed,"fail":reader.failed,"skip":reader.skipped,"todo":reader.todo}),
+        rows: reader.rows,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tap_nested_numbers_restart() {
+        let report =
+            parse("ok 1 first\n# Subtest: child\n    ok 1 inner\n    1..1\nok 2 child\n1..2")
+                .unwrap();
+        assert_eq!(report.rows[1]["scope"], json!(["child"]));
+        assert_eq!(report.rows[2]["number"], 2);
+        assert_eq!(report.summary["pass"], 3);
+    }
+
+    #[test]
+    fn tap_diagnostic_is_opaque() {
+        let report = parse("not ok - issue\n  ---\n  1..900\n  ...\n1..1").unwrap();
+        assert_eq!(report.rows[0]["diagnostic"], json!(["1..900"]));
+    }
+}
diff --git a/src/tools/report/tap/point.rs b/src/tools/report/tap/point.rs
new file mode 100644
index 0000000..3591fb7
--- /dev/null
+++ b/src/tools/report/tap/point.rs
@@ -0,0 +1,60 @@
+pub(super) fn count(raw: &str) -> Option<usize> {
+    if raw.is_empty() || !raw.bytes().all(|c| c.is_ascii_digit()) {
+        return None;
+    }
+    raw.parse().ok()
+}
+
+pub(super) fn directive(label: &str) -> (&str, Option<(&str, &str)>) {
+    for (offset, _) in label.match_indices('#') {
+        if offset > 0 && !label[..offset].ends_with(' ') {
+            continue;
+        }
+        let tail = label[offset + 1..].trim();
+        let (word, reason) = tail.split_once(' ').unwrap_or((tail, ""));
+        for kind in ["skip", "todo"] {
+            if word.eq_ignore_ascii_case(kind) {
+                return (label[..offset].trim_end(), Some((kind, reason.trim())));
+            }
+        }
+    }
+    (label.trim_end(), None)
+}
+
+pub(super) struct Point<'a> {
+    pub(super) name: &'a str,
+    pub(super) status: &'static str,
+    pub(super) reason: &'a str,
+}
+
+pub(super) fn point(line: &str, next: usize) -> Option<Point<'_>> {
+    let (passed, rest) = if let Some(rest) = line.strip_prefix("not ok") {
+        (false, rest)
+    } else {
+        (true, line.strip_prefix("ok")?)
+    };
+    if !rest.is_empty() && !rest.starts_with(' ') {
+        return None;
+    }
+    let mut label = rest.trim();
+    let first = label.split(' ').next().unwrap_or("");
+    if !first.is_empty() && first.bytes().all(|c| c.is_ascii_digit()) {
+        if count(first)? != next {
+            return None;
+        }
+        label = label[first.len()..].trim_start();
+    }
+    label = label.strip_prefix("- ").unwrap_or(label);
+    let (name, dir) = directive(label);
+    let (status, reason) = match dir {
+        Some(("skip", reason)) => ("skip", reason),
+        Some((_, reason)) => ("todo", reason),
+        None if passed => ("pass", ""),
+        None => ("fail", ""),
+    };
+    Some(Point {
+        status,
+        reason,
+        name,
+    })
+}
