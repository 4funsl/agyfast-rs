new file mode 100644
index 0000000..78cb6ab
--- /dev/null
+++ b/src/tools/report/diff/header.rs
@@ -0,0 +1,34 @@
+fn number(raw: &str) -> Option<u64> {
+    if raw.is_empty() || !raw.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    raw.parse().ok()
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct Range {
+    pub(super) start: u64,
+    pub(super) count: u64,
+}
+
+fn range(raw: &str, prefix: char) -> Option<Range> {
+    let spec = raw.strip_prefix(prefix)?;
+    let (start, count) = spec.split_once(',').unwrap_or((spec, "1"));
+    let (start, count) = (number(start)?, number(count)?);
+    if start == 0 && count != 0 {
+        return None;
+    }
+    start.checked_add(count)?;
+    Some(Range { start, count })
+}
+
+pub(super) fn header(raw: &str) -> Option<(Range, Range, &str)> {
+    let (coords, tail) = raw.strip_prefix("@@ ")?.split_once(" @@")?;
+    let (left, right) = coords.split_once(' ')?;
+    let heading = if tail.is_empty() {
+        ""
+    } else {
+        tail.strip_prefix(' ')?
+    };
+    Some((range(left, '-')?, range(right, '+')?, heading))
+}
diff --git a/src/tools/report/diff/mod.rs b/src/tools/report/diff/mod.rs
new file mode 100644
index 0000000..1dd8c46
--- /dev/null
+++ b/src/tools/report/diff/mod.rs
@@ -0,0 +1,125 @@
+mod header;
+mod paths;
+mod regions;
+use super::Report;
+use header::{Range, header};
+use paths::path;
+use regions::body;
+use serde_json::{Value, json};
+
+fn error(line: usize, why: &str) -> String {
+    format!("diff line {line}: {why}")
+}
+
+#[derive(Default)]
+struct Totals {
+    files: usize,
+    hunks: usize,
+    added: u64,
+    removed: u64,
+}
+
+struct Hunk<'a> {
+    old: &'a Option<String>,
+    new: &'a Option<String>,
+    id: usize,
+    heading: &'a str,
+}
+
+pub(super) fn parse(src: &str) -> Result<Report, String> {
+    // A mailed patch begins with an envelope and a human-readable cover letter.
+    let mut lines: Vec<_> = src.lines().collect();
+    if lines.first().is_some_and(|line| line.starts_with("From "))
+        && let Some(start) = lines
+            .iter()
+            .position(|line| line.starts_with("diff --git "))
+    {
+        lines.drain(..start);
+    }
+    let mut pos = 0;
+    let mut totals = Totals::default();
+    let mut rows = Vec::new();
+    while pos < lines.len() {
+        let line = lines[pos];
+        if line.is_empty()
+            || [
+                "diff --git ",
+                "index ",
+                "new file mode ",
+                "deleted file mode ",
+            ]
+            .iter()
+            .any(|prefix| line.starts_with(prefix))
+        {
+            pos += 1;
+            continue;
+        }
+        let old = path(
+            line.strip_prefix("--- ")
+                .ok_or_else(|| error(pos + 1, "expected --- path"))?,
+            "a/",
+            pos + 1,
+        )?;
+        pos += 1;
+        let raw = lines
+            .get(pos)
+            .and_then(|s| s.strip_prefix("+++ "))
+            .ok_or_else(|| error(pos + 1, "expected +++ path"))?;
+        let new = path(raw, "b/", pos + 1)?;
+        if new.is_none() && old.is_none() {
+            return Err(error(pos + 1, "two null paths"));
+        }
+        pos += 1;
+        totals.files += 1;
+        let mut id = 0;
+        while let Some(line) = lines.get(pos).filter(|s| s.starts_with("@@")) {
+            let (left, right, heading) =
+                header(line).ok_or_else(|| error(pos + 1, "invalid hunk header"))?;
+            pos += 1;
+            id += 1;
+            totals.hunks += 1;
+            body(
+                &lines,
+                &mut pos,
+                left,
+                right,
+                Hunk {
+                    old: &old,
+                    new: &new,
+                    id,
+                    heading,
+                },
+                &mut rows,
+                &mut totals,
+            )?;
+        }
+    }
+    Ok(Report {
+        rows,
+        summary: json!({"files":totals.files, "hunks":totals.hunks,
+        "added":totals.added, "removed":totals.removed}),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn diff_marker_between_edits() {
+        let r = parse("--- a/x\n+++ b/x\n@@ -10 +20 @@ f\n-x\n\\ No newline at end of file\n+y")
+            .unwrap();
+        assert_eq!(r.rows.len(), 1);
+        assert_eq!(r.rows[0]["oldAt"], 10);
+        assert_eq!(r.rows[0]["added"], 1);
+    }
+
+    #[test]
+    fn diff_quoted_utf8_path() {
+        assert_eq!(
+            path(r#""a/\316\273""#, "a/", 1).unwrap().as_deref(),
+            Some("λ")
+        );
+        assert!(path(r#""a/\377""#, "a/", 1).is_err());
+    }
+}
