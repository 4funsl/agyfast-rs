{
  "mcpServers": {
    "rs": {
      "command": "sh",
      "args": [
        "-c",
        "exec \"$0\" mcp",
        "${PLUGIN_ROOT}/bin/agyfast-rs"
      ],
      "tools": {
        "batch_search": {
          "eager": true
        },
        "quick_outline": {
          "eager": true
        },
        "apply_edits": {
          "eager": true
        },
        "run_checks": {
          "eager": true
        }
      }
    }
  }
}